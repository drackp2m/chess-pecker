		"IntroI18n.PURPOSE_TITLE#gender:other": { "ref": ["Welcome to Chess Pecker"] },
		"IntroI18n.PURPOSE_BODY_1": {
			"ref": [
				"Chess Pecker is an app for training tactics with the Woodpecker method. It is not a pile of puzzles to work through: it is a training programme with a beginning, an end and a concrete way of telling whether you are getting better."
			]
		},
		"IntroI18n.PURPOSE_BODY_2": {
			"ref": [
				"The app takes care of the whole run: it builds your set of exercises, keeps count of every cycle and shows you how much you have gained in speed and accuracy. It works offline too and keeps your progress on the device, so you can train wherever and whenever you like."
			]
		},
