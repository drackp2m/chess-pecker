{
	"name": "@drackp2m/transloco-ulid-cli",
	"version": "0.1.0",
	"description": "Checks, exports and imports a ULID-keyed Transloco catalogue, with XLIFF 2.0 round-trips for translators.",
	"author": "Marc Jovaní González",
	"license": "MIT",
	"keywords": [
		"transloco",
		"i18n",
		"ulid",
		"xliff",
		"icu",
		"angular"
	],
	"bin": {
		"transloco-ulid": "./bin/transloco-ulid.mjs"
	},
	"exports": {
		"./*": "./src/*"
	},
	"files": [
		"bin",
		"src",
		"!src/**/*.test.mjs"
	],
	"engines": {
		"node": ">=20"
	},
	"publishConfig": {
		"access": "public"
	},
	"dependencies": {
		"@messageformat/parser": "5.1.1"
	},
	"peerDependencies": {
		"typescript": ">=5.0.0"
	},
	"devDependencies": {
		"typescript": "6.0.3"
	}
}
