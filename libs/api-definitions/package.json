{
	"name": "@chesspecker/api-definitions",
	"version": "0.0.0",
	"description": "Shapes that cross the HTTP boundary between the web app and the API.",
	"author": "Marc Jovaní González",
	"private": true,
	"types": "./src/index.ts",
	"exports": {
		".": {
			"types": "./src/index.ts",
			"default": "./dist/index.js"
		}
	},
	"files": [
		"src",
		"dist"
	],
	"scripts": {
		"typecheck": "tsc --noEmit -p tsconfig.json",
		"build": "tsc -p tsconfig.build.json",
		"dev": "tsc -p tsconfig.build.json --watch"
	},
	"devDependencies": {
		"typescript": "7.0.2"
	},
	"dependencies": {
		"zod": "^4.5.4"
	}
}
