{
	"name": "chesspecker",
	"version": "1.29.5",
	"author": "Marc Jovaní González",
	"private": true,
	"packageManager": "pnpm@11.25.0",
	"scripts": {
		"dev:api": "pnpm --filter @chesspecker/api start:safari",
		"dev:web": "pnpm --filter @chesspecker/web start:safari",
		"lint": "node tools/scripts/lint/lint.mjs --max-warnings 0",
		"lint:fix": "node tools/scripts/lint/lint.mjs --fix --max-warnings 0 --verbose",
		"i18n:check": "node tools/scripts/i18n/check.mjs",
		"i18n:export": "node tools/scripts/i18n/export.mjs",
		"i18n:import": "node tools/scripts/i18n/import.mjs",
		"i18n:clear": "node tools/scripts/i18n/clear.mjs",
		"i18n:state": "node tools/scripts/i18n/state.mjs",
		"test:tools": "node tools/scripts/test/tools-test.mjs",
		"test:lock": "node tools/scripts/test-lock/index.mjs",
		"test:lock:select": "node tools/scripts/test-lock/index.mjs --select",
		"typescript:match": "node tools/scripts/match-typescript-version.mjs",
		"update:deps": "sh tools/scripts/update-deps.sh",
		"git:sync": "sh tools/scripts/sync-git-main.sh",
		"pnpm:match": "node tools/scripts/match-pnpm-version.mjs",
		"import:puzzles": "node tools/scripts/import-puzzles.mjs",
		"split:chess": "node tools/scripts/split-chess-set.mjs",
		"svg:clean": "node tools/scripts/optimize-svg.mjs",
		"prepare": "node .husky/prepare.mjs"
	},
	"devDependencies": {
		"@eslint/js": "10.0.1",
		"@messageformat/parser": "5.1.1",
		"@semantic-release/changelog": "7.0.0",
		"@semantic-release/exec": "7.1.0",
		"@semantic-release/git": "11.0.1",
		"@stylistic/eslint-plugin": "5.10.0",
		"angular-eslint": "22.2.0",
		"commitizen": "4.3.2",
		"commitlint": "21.2.2",
		"conventional-changelog-conventionalcommits": "10.4.0",
		"cz-emoji": "1.3.2-canary.2",
		"eslint": "10.9.1",
		"eslint-plugin-import-x": "4.17.1",
		"eslint-plugin-rxjs-updated": "1.0.50",
		"eslint-plugin-sonarjs": "4.2.0",
		"eslint-plugin-unused-imports": "4.4.1",
		"globals": "17.12.0",
		"husky": "9.1.7",
		"lint-staged": "17.4.1",
		"prettier": "3.9.6",
		"semantic-release": "25.0.9",
		"stylelint": "17.14.1",
		"stylelint-config-clean-order": "10.0.0",
		"stylelint-config-standard-scss": "17.0.0",
		"typescript": "6.0.3",
		"typescript-eslint": "8.69.0"
	}
}
