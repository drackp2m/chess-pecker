# See https://docs.github.com/get-started/getting-started-with-git/ignoring-files for more about ignoring files.

# Compiled output
dist/
/tmp
out-tsc/
/bazel-out

# Node
node_modules/
npm-debug.log
yarn-error.log

# IDEs and editors
.idea/
.project
.classpath
.c9/
*.launch
.settings/
*.sublime-workspace

# Visual Studio Code
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
.history/*

# Miscellaneous
.sass-cache/
/connect.lock
coverage/
/libpeerconnection.log
testem.log
/typings

# Environment
# One .env at the repo root, never committed: Docker Compose reads it to
# interpolate ${APP_PORT}, and the API loads it too (see env.validation.ts).
# .env.example is the tracked template — copy it on a fresh clone.
.env
*.env.local

# System files
.DS_Store
Thumbs.db

.angular
.docker
.pnpm-store

# Postgres data dir, bind-mounted by the chesspecker-db service
.pgdata

# MikroORM writes one schema snapshot per database; only the dev one is tracked,
# the test one is a byproduct of `test:integration` replaying the migrations
apps/api/migrations/.snapshot-*_test.json

# Claude Code
.claude/hook-errors.log

# Local dev SSL certificates (mkcert)
.cert/

/ideas

# XLIFF handed to translators: a derived export of apps/web/src/app/i18n,
# regenerated by `pnpm i18n:export` and read back by `pnpm i18n:import`
/translations

# Python: the i18n translator (tools/scripts/i18n/translate) is a uv project
# that only runs on the host — its virtualenv and bytecode never leave the Mac
.venv/
__pycache__/

# What `uv run translate --bench` writes: one XLIFF per model pass and the
# markdown comparing them. Derived from tools/scripts/i18n/bench, and big
bench-runs/
