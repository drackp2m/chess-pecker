{
	"$schema": "./node_modules/@angular/cli/lib/config/schema.json",
	"version": 1,
	"cli": {
		"packageManager": "pnpm",
		"analytics": "64e6cc2e-fff3-4b9d-8a09-e99c02a988f2"
	},
	"newProjectRoot": "projects",
	"projects": {
		"chesspecker": {
			"projectType": "application",
			"schematics": {
				"@schematics/angular:component": {
					"style": "scss"
				}
			},
			"root": "",
			"sourceRoot": "src",
			"prefix": "app",
			"architect": {
				"build": {
					"builder": "@angular/build:application",
					"options": {
						"browser": "src/main.ts",
						"tsConfig": "tsconfig.app.json",
						"inlineStyleLanguage": "scss",
						"assets": [
							{
								"glob": "**/*",
								"input": "public"
							},
							{
								"glob": "**/*.json",
								"input": "src/app/i18n",
								"output": "i18n",
								"ignore": ["context/**", "state/**"]
							}
						],
						"styles": ["src/styles.scss"],
						"serviceWorker": "src/ngsw-config.json",
						"define": {
							"APP_DEBUG": "false",
							"API_URL": "'https://localhost:3000/api'"
						}
					},
					"configurations": {
						"production": {
							"budgets": [
								{
									"type": "initial",
									"maximumWarning": "500kB",
									"maximumError": "1MB"
								},
								{
									"type": "anyComponentStyle",
									"maximumWarning": "4kB",
									"maximumError": "8kB"
								}
							],
							"outputHashing": "all",
							"define": {
								"APP_DEBUG": "false",
								"API_URL": "'https://api.chess.drackp2m.dev/api'"
							}
						},
						"development": {
							"optimization": false,
							"extractLicenses": false,
							"sourceMap": true,
							"define": {
								"APP_DEBUG": "true",
								"API_URL": "'https://localhost:3000/api'"
							}
						},
						"testing": {
							"optimization": false,
							"extractLicenses": false,
							"sourceMap": true
						},
						"typecheck": {
							"optimization": false,
							"extractLicenses": false,
							"sourceMap": false,
							"outputPath": "dist/typecheck"
						}
					},
					"defaultConfiguration": "production"
				},
				"serve": {
					"builder": "@angular/build:dev-server",
					"options": {
						"host": "0.0.0.0",
						"ssl": true,
						"sslCert": "../../.cert/cert.pem",
						"sslKey": "../../.cert/key.pem",
						"allowedHosts": ["marcbook-air.local", "localhost"]
					},
					"configurations": {
						"production": {
							"buildTarget": "chesspecker:build:production"
						},
						"development": {
							"buildTarget": "chesspecker:build:development"
						}
					},
					"defaultConfiguration": "development"
				}
			}
		},
		"unit": {
			"projectType": "application",
			"root": "",
			"sourceRoot": "src",
			"prefix": "app",
			"architect": {
				"test": {
					"builder": "@angular/build:unit-test",
					"options": {
						"buildTarget": "chesspecker:build:testing",
						"tsConfig": "tsconfig.spec.json",
						"runnerConfig": "vitest.config.ts"
					}
				}
			}
		}
	}
}
