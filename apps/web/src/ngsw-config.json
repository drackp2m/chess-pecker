{
	"$schema": "../node_modules/@angular/service-worker/config/schema.json",
	"index": "/index.html",
	"appData": {
		"version": "1.29.0"
	},
	"assetGroups": [
		{
			"name": "app",
			"installMode": "prefetch",
			"updateMode": "prefetch",
			"resources": {
				"files": [
					"/index.html",
					"/favicon.ico",
					"/favicon.svg",
					"/manifest.webmanifest",
					"/*.js",
					"/*.css"
				]
			}
		},
		{
			"name": "assets",
			"installMode": "prefetch",
			"updateMode": "lazy",
			"resources": {
				"files": [
					"/font/**",
					"/svg/**",
					"/sound/**",
					"/i18n/**",
					"/icon-*.png",
					"/apple-touch-icon.png"
				]
			}
		}
	]
}
