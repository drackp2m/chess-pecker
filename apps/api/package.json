{
	"name": "@chesspecker/api",
	"version": "0.0.1",
	"description": "",
	"author": "",
	"private": true,
	"license": "UNLICENSED",
	"scripts": {
		"migration:check": "mikro-orm migration:pending",
		"migration:create": "mikro-orm migration:create",
		"migration:execute": "mikro-orm migration:up",
		"migration:undo": "mikro-orm migration:down",
		"build": "nest build && tsc -p tsconfig.migrations.json",
		"start": "nest start",
		"start:dev": "nest start --watch",
		"start:safari": "sh ../../tools/scripts/start-safari.sh --source 3000 --env API_PROTOCOL=http --env API_PORT=3001 -- nest start --watch",
		"start:debug": "nest start --debug --watch",
		"start:prod": "node dist/main",
		"test": "vitest run --project unit",
		"test:watch": "vitest --project unit",
		"test:cov": "vitest run --project unit --coverage",
		"test:debug": "vitest --project unit --inspect-brk --no-file-parallelism",
		"test:integration": "NODE_ENV=test vitest run --project integration",
		"test:integration:watch": "NODE_ENV=test vitest --project integration",
		"typecheck": "tsc --noEmit -p tsconfig.json"
	},
	"dependencies": {
		"@chesspecker/api-definitions": "workspace:*",
		"@mikro-orm/cli": "^6.6.7",
		"@mikro-orm/core": "^6.6.7",
		"@mikro-orm/migrations": "^6.6.7",
		"@mikro-orm/nestjs": "^6.1.1",
		"@mikro-orm/postgresql": "^6.6.7",
		"@nestjs/common": "^11.0.1",
		"@nestjs/config": "^4.0.3",
		"@nestjs/core": "^11.0.1",
		"@nestjs/jwt": "^11.0.2",
		"@nestjs/passport": "^11.0.5",
		"@nestjs/platform-express": "^11.0.1",
		"bcryptjs": "^3.0.3",
		"class-transformer": "^0.5.1",
		"class-validator": "^0.14.3",
		"cookie-parser": "^1.4.7",
		"dotenv": "^16.4.7",
		"express": "^5.0.0",
		"ms": "^2.1.3",
		"passport-jwt": "^4.0.1",
		"reflect-metadata": "^0.2.2",
		"rxjs": "^7.8.1"
	},
	"devDependencies": {
		"@faker-js/faker": "^10.5.0",
		"@nestjs/cli": "^11.0.0",
		"@nestjs/schematics": "^11.0.0",
		"@nestjs/testing": "^11.0.1",
		"@swc/core": "1.15.46",
		"@types/cookie-parser": "^1.4.10",
		"@types/express": "^5.0.0",
		"@types/ms": "^2.1.0",
		"@types/node": "^22.10.7",
		"@types/passport-jwt": "^4.0.1",
		"@types/supertest": "^6.0.2",
		"@vitest/coverage-v8": "4.1.10",
		"source-map-support": "^0.5.21",
		"supertest": "^7.0.0",
		"ts-loader": "^9.5.2",
		"ts-node": "^10.9.2",
		"tsconfig-paths": "^4.2.0",
		"unplugin-swc": "^1.5.9",
		"vitest": "4.1.10",
		"vitest-mock-extended": "^5.1.0"
	}
}
