{
	"name": "@chesspecker/api",
	"version": "0.0.1",
	"description": "",
	"author": "",
	"private": true,
	"license": "UNLICENSED",
	"scripts": {
		"migration:check": "mikro-orm migration:pending",
		"migration:create": "mikro-orm migration:create",
		"migration:execute": "mikro-orm migration:up",
		"migration:undo": "mikro-orm migration:down",
		"build": "pnpm --filter @chesspecker/api-definitions build && nest build && tsc -p tsconfig.migrations.json",
		"start": "pnpm --filter @chesspecker/api-definitions build && nest start",
		"start:dev": "pnpm --filter @chesspecker/api-definitions build && nest start --watch",
		"start:safari": "pnpm --filter @chesspecker/api-definitions build && sh ../../tools/scripts/start-safari.sh --source 3000 --env API_PROTOCOL=http --env API_PORT=3001 -- nest start --watch",
		"start:debug": "nest start --debug --watch",
		"start:prod": "pnpm --filter @chesspecker/api-definitions build && node dist/main",
		"test": "pnpm --filter @chesspecker/api-definitions build && vitest run --project unit",
		"test:watch": "vitest --project unit",
		"test:cov": "vitest run --project unit --coverage",
		"test:debug": "vitest --project unit --inspect-brk --no-file-parallelism",
		"test:integration": "pnpm --filter @chesspecker/api-definitions build && NODE_ENV=test vitest run --project integration",
		"test:integration:watch": "NODE_ENV=test vitest --project integration",
		"typecheck": "tsc --noEmit -p tsconfig.json"
	},
	"dependencies": {
		"@chesspecker/api-definitions": "workspace:*",
		"@mikro-orm/cli": "^7.1.14",
		"@mikro-orm/core": "^7.1.14",
		"@mikro-orm/decorators": "^7.1.14",
		"@mikro-orm/migrations": "^7.1.14",
		"@mikro-orm/nestjs": "^7.1.0",
		"@mikro-orm/postgresql": "^7.1.14",
		"@nestjs/common": "^12.0.1",
		"@nestjs/config": "^12.0.0",
		"@nestjs/core": "^12.0.1",
		"@nestjs/jwt": "^12.0.1",
		"@nestjs/passport": "^12.0.0",
		"@nestjs/platform-express": "^12.0.1",
		"bcryptjs": "^3.0.3",
		"cookie-parser": "^1.4.7",
		"dotenv": "^17.4.2",
		"express": "^5.2.1",
		"ms": "^2.1.3",
		"passport-jwt": "^4.0.1",
		"reflect-metadata": "^0.2.2",
		"rxjs": "^7.8.2"
	},
	"devDependencies": {
		"@faker-js/faker": "^10.6.0",
		"@nestjs/cli": "^12.0.0",
		"@nestjs/schematics": "^12.0.0",
		"@nestjs/testing": "^12.0.1",
		"@swc/core": "1.16.1",
		"@types/cookie-parser": "^1.4.10",
		"@types/express": "^5.0.6",
		"@types/ms": "^2.1.0",
		"@types/node": "^26.4.1",
		"@types/passport-jwt": "^4.0.1",
		"@types/supertest": "^7.2.1",
		"@vitest/coverage-v8": "4.1.11",
		"source-map-support": "^0.5.21",
		"supertest": "^7.2.2",
		"ts-loader": "^9.6.2",
		"ts-node": "^10.9.2",
		"tsconfig-paths": "^4.2.0",
		"unplugin-swc": "^1.5.11",
		"vitest": "4.1.11",
		"vitest-mock-extended": "^5.1.1"
	}
}
