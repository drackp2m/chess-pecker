{
	"extends": "../../tsconfig.base.json",
	"compilerOptions": {
		// Module & target
		"target": "ES2023",
		"module": "nodenext",
		"moduleResolution": "nodenext",
		"resolvePackageJsonExports": true,
		"esModuleInterop": true,
		"allowSyntheticDefaultImports": true,
		"experimentalDecorators": true,
		"emitDecoratorMetadata": true,

		// TypeScript 6 no longer pulls in every @types/* package automatically, so
		// each config states what it needs. This one covers the editor and the
		// type-aware ESLint pass, which both see the spec files.
		"types": ["node", "jest"],

		// Emit
		"outDir": "./dist",
		"rootDir": "src",
		"sourceMap": true,
		"removeComments": true,
		"incremental": true,
		"tsBuildInfoFile": "./dist/tsconfig.tsbuildinfo",

		// TODO: delete every flag below and inherit the full strictness baseline
		// from tsconfig.base.json. They are the boilerplate this app arrived with,
		// not a decision — the repo standard (AGENTS.md) is the base file. Remove
		// them one at a time and fix the fallout, together with the matching TODO
		// block in the root eslint.config.mjs.
		"noImplicitAny": false,
		"strictBindCallApply": false,
		"noUncheckedIndexedAccess": false,
		"exactOptionalPropertyTypes": false,
		"noPropertyAccessFromIndexSignature": false
	},
	"include": ["src/**/*"],
	"exclude": ["dist"]
}
