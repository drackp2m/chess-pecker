{
	// For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
	"version": "0.2.0",
	"configurations": [
		{
			"name": "i18n extension",
			"type": "extensionHost",
			"request": "launch",
			"args": [
				"--extensionDevelopmentPath=${workspaceFolder}/tools/vscode-i18n",
				"${workspaceFolder}"
			]
		},
		{
			"name": "ng serve",
			"type": "chrome",
			"request": "launch",
			"url": "http://localhost:4200/"
		},
		{
			"name": "ng test",
			"type": "chrome",
			"request": "launch",
			"url": "http://localhost:9876/debug.html"
		}
	]
}
